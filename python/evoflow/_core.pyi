    def add_connectivity_constraint(self, variable: str, vertices: _IntLike, edges: Any, terminals: Sequence[_IntLike] = ..., penalty: _FloatLike = 1.0, objectives: Any = None) -> None: ...
    def add_constant(self, name: str, values: Sequence[_FloatLike], height: _IntLike = 1) -> int: ...
    def add_distinct_cap_constraint(self, variable: str, maximum: _IntLike, penalty: _FloatLike = 1.0, objectives: Any = None) -> None: ...
    def add_distributed_constraint(self, variable: str, values: Sequence[_FloatLike], counts: Sequence[_IntLike], penalty: _FloatLike = 1.0, objectives: Any = None) -> None: ...
    def add_eligible_constraint(self, variable: str, allowed: Sequence[Sequence[_FloatLike]], penalty: _FloatLike = 1.0, objectives: Any = None) -> None: ...
    def add_expression_constraint(self, variable: str, inputs: Any, formula: str, penalty: _FloatLike = 1.0, objectives: Any = None) -> None: ...
    def add_formula_heuristic(self, variable: str, inputs: Any, formula: str, stable: bool = False) -> None: ...
    def add_graph_constraint(self, kind: str, variable: str, edges: Any, penalty: _FloatLike = 1.0, objectives: Any = None) -> None: ...
    def add_matrix_heuristic(self, variable: str, matrix: Sequence[Sequence[_FloatLike]]) -> None: ...
    def add_min_distance_constraint(self, variable: str, gap: Any, penalty: _FloatLike = 1.0, objectives: Any = None) -> None: ...
    def add_node_sum_constraint(self, variable: str, vertices: _IntLike, edges: Any, directed: bool, lower: Sequence[_FloatLike], upper: Sequence[_FloatLike], capacity: Sequence[_FloatLike], penalty: _FloatLike = 1.0, objectives: Any = None) -> None: ...
    def add_objective(self, name: str, inputs: Any, callback: Any, priority: _IntLike = 0, minimize: bool = True) -> None: ...
    def add_objective_formula(self, name: str, inputs: Any, formula: str, priority: _IntLike = 0, minimize: bool = True) -> None: ...
    def add_random_heuristic(self, variable: str) -> None: ...
    def add_range_constraint(self, variable: str, lower: Any = None, upper: Any = None, penalty: _FloatLike = 1.0, objectives: Any = None) -> None: ...
    def add_schedule_accumulate_constraint(self, variable: str, node_count: _IntLike, predecessors: Sequence[Sequence[_IntLike]], execution: Sequence[Sequence[_FloatLike]], communication_data: Sequence[Sequence[_FloatLike]], communication_rate: Sequence[Sequence[_FloatLike]], deadlines: Sequence[_FloatLike], penalty: _FloatLike = 1.0, objectives: Any = None) -> None: ...
    def add_sequence_accumulate_constraint(self, variable: str, delta: Sequence[_FloatLike], lower: _FloatLike, upper: _FloatLike, initial: _FloatLike = 0.0, penalty: _FloatLike = 1.0, objectives: Any = None) -> None: ...
    def add_unique_constraint(self, variable: str, penalty: _FloatLike = 1.0, objectives: Any = None) -> None: ...
    def add_variable(self, name: str, lower: _FloatLike, upper: _FloatLike, accuracy: _FloatLike, length: _IntLike, height: _IntLike = 1, type: VariableType = VariableType.DISCRETE) -> int: ...
    def clear(self) -> None: ...
    def compile(self) -> CompiledProblem: ...
