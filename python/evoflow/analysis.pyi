import os
from dataclasses import dataclass
from typing import Any, Callable, Iterable, Optional, Sequence, Tuple, Union

from ._core import (
    ChartArtifact as ChartArtifact,
    ChartFormat as ChartFormat,
    ChartKind as ChartKind,
    ChartLanguage as ChartLanguage,
    Comparison as Comparison,
    Direction as Direction,
    ExperimentBatch as ExperimentBatch,
    Indicator as Indicator,
    Normalization as Normalization,
    Palette as Palette,
    ProcessHeader as ProcessHeader,
    ProcessLog as ProcessLog,
    ProcessRecord as ProcessRecord,
    ProcessScanResult as ProcessScanResult,
    ReportFormat as ReportFormat,
    Statistic as Statistic,
)

PathInput = Union[str, bytes, os.PathLike]

@dataclass(frozen=True)
class AnalysisTable:
    header: Tuple[str, ...]
    subheader: Tuple[str, ...]
    rows: Tuple[str, ...]
    cells: Tuple[Tuple[str, ...], ...]
    bolds: Optional[Tuple[Tuple[int, ...], ...]] = ...

@dataclass(frozen=True)
class AnalysisResult:
    warnings: Tuple[str, ...]
    batches: Tuple[ExperimentBatch, ...]
    chosen: ExperimentBatch
    table: AnalysisTable
    chart_files: Tuple[str, ...]
    charts: Tuple[ChartArtifact, ...]

class AnalysisError(RuntimeError):
    batches: Tuple[ExperimentBatch, ...]
    def __init__(self, message: str, batches: Iterable[ExperimentBatch] = ...) -> None: ...

@dataclass(frozen=True)
class Reducer:
    kind: str
    metric: Any = ...
    objective: int = ...
    value: float = ...
    references: Tuple[Tuple[float, ...], ...] = ...
    @classmethod
    def statistic(cls, metric: Statistic, *, objective: int = ...) -> "Reducer": ...
    @classmethod
    def percentile(cls, value: float, *, objective: int = ...) -> "Reducer": ...
    @classmethod
    def indicator(cls, metric: Indicator, references: Sequence[Sequence[float]]) -> "Reducer": ...

@dataclass(frozen=True)
class Aggregation:
    kind: str
    metric: Any = ...
    value: float = ...
    @classmethod
    def statistic(cls, metric: Statistic) -> "Aggregation": ...
    @classmethod
    def percentile(cls, value: float) -> "Aggregation": ...

@dataclass(frozen=True)
class ComparisonSpec:
    comparison: Comparison
    on: Statistic = ...
    direction: Direction = ...

@dataclass(frozen=True)
class ChartSpec:
    id: str
    kind: ChartKind
    problem: int = ...
    statistic: Statistic = ...
    band: Optional[Tuple[Statistic, Statistic]] = ...
    normalization: Normalization = ...
    jitter: bool = ...
    grid: int = ...
    objective_x: int = ...
    objective_y: int = ...
    run: int = ...
    connect: bool = ...

@dataclass(frozen=True)
class ChartStyle:
    palette: Palette = ...
    language: ChartLanguage = ...
    caption: bool = ...
    log_scale: bool = ...
    reverse_y: bool = ...

@dataclass(frozen=True)
class PngFont:
    latin: str = ...
    cjk: str = ...
    cjk_index: int = ...
    scale: float = ...

def discover_batches(log_path: PathInput = ...) -> Tuple[ExperimentBatch, ...]: ...
def analyze(log_path: PathInput = ..., *, tag: str, optimizers: Sequence[str] = ..., problems: Sequence[str] = ..., reducer: Optional[Reducer] = ..., statistics: Optional[Sequence[Union[Statistic, Aggregation]]] = ..., comparisons: Optional[Sequence[Union[Comparison, ComparisonSpec]]] = ..., baseline: Optional[str] = ..., charts: Optional[Sequence[ChartSpec]] = ..., charts_dir: Optional[PathInput] = ..., chart_format: ChartFormat = ..., png_font: Optional[PngFont] = ...) -> AnalysisResult: ...

class Analyzer:
    def __init__(self, log_root: PathInput = ...) -> None: ...
    def add_optimizer(self, name: str, tag: str, repeats: int) -> "Analyzer": ...
    def add_problem(self, name: str) -> "Analyzer": ...
    def add_problems(self, names: Iterable[str]) -> "Analyzer": ...
    def reduce_by(self, metric: Union[Statistic, Indicator], *, objective: int = ..., references: Sequence[Sequence[float]] = ...) -> "Analyzer": ...
    def reduce_percentile(self, value: float, *, objective: int = ...) -> "Analyzer": ...
    def add_statistic(self, statistic: Statistic) -> "Analyzer": ...
    def add_percentile(self, value: float) -> "Analyzer": ...
    def add_comparison(self, comparison: Comparison, *, on: Statistic = ..., direction: Direction = ...) -> "Analyzer": ...
    def run(self) -> AnalysisTable: ...
    def table(self) -> AnalysisTable: ...
    def report(self, format: ReportFormat, path: PathInput) -> str: ...
    def set_chart_style(self, style: ChartStyle) -> "Analyzer": ...
    def chart(self, kind: ChartKind, path: PathInput, *, title: str = ..., problems: Optional[Union[int, Iterable[int]]] = ..., normalization: Normalization = ..., jitter: bool = ..., statistic: Optional[Statistic] = ..., band: Optional[Tuple[Statistic, Statistic]] = ..., grid: int = ..., objective_x: int = ..., objective_y: int = ..., run: int = ..., swarm: str = ..., connect: bool = ..., format: ChartFormat = ..., style: Optional[ChartStyle] = ..., png_font: Optional[PngFont] = ...) -> Tuple[str, ...]: ...
    def clear_metrics(self) -> "Analyzer": ...
    def clear_all(self) -> "Analyzer": ...

def read_process(path: PathInput) -> ProcessLog: ...
def scan_process(path: PathInput, callback: Callable[[ProcessRecord], Any]) -> ProcessScanResult: ...
